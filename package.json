{
  "name": "@vexorjs/monorepo",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "benchmarks"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint && biome lint .",
    "lint:fix": "biome lint --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "bench": "npm run bench:quick --workspace=vexor-benchmarks",
    "bench:quick": "npm run bench:quick --workspace=vexor-benchmarks",
    "bench:compare": "npm run bench:compare --workspace=vexor-benchmarks",
    "bench:http": "npm run bench:http --workspace=vexor-benchmarks",
    "bench:orm": "npm run bench:orm --workspace=vexor-benchmarks",
    "example:api": "node examples/basic-api/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "tsup": "^8.3.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "optionalDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1"
  }
}
